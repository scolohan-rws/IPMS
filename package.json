{
  "name": "ipms-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda for IPMS API Gateway",
  "type": "module",
  "main": "lambda/dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "biome check .",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "dev": "sst dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "start": "npm run build && node lambda/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@aws-lambda-powertools/event-handler": "^2.34.0",
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-sdk/rds-signer": "^3.1098.0",
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "sst": "4.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --no-errors-on-unmatched"
    ]
  }
}
